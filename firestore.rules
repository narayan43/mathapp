rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Sane overall field count & payload size guard
    function isSaneDocSize(data, maxKeys) {
      return data.keys().size() >= 1 && data.keys().size() <= maxKeys;
    }

    // 7-day limit for anonymous guests: permanent providers (google, password, email) have no expiration
    function isGuestActive(createdTimestamp) {
      return !('sign_in_provider' in request.auth.token.firebase) ||
             request.auth.token.firebase.sign_in_provider != 'anonymous' ||
             createdTimestamp == null ||
             !(createdTimestamp is timestamp) ||
             (request.time < createdTimestamp + duration.value(7, 'd'));
    }

    function isValidUserProfile(data) {
      return isSaneDocSize(data, 15) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             data.avatarId is string && data.avatarId.size() >= 1 && data.avatarId.size() <= 40 &&
             (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 600)) &&
             (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 160)) &&
             (!('provider' in data) || data.provider == null || (data.provider is string && data.provider in ['google', 'email', 'guest', 'anonymous', 'firebase'])) &&
             data.dailyGoal is int && data.dailyGoal >= 5 && data.dailyGoal <= 200 &&
             data.language is string && data.language.size() >= 2 && data.language.size() <= 12 &&
             data.theme is string && data.theme.size() >= 2 && data.theme.size() <= 32 &&
             (!('accentTheme' in data) || data.accentTheme == null || (data.accentTheme is string && data.accentTheme.size() <= 32)) &&
             (!('settingsJson' in data) || (data.settingsJson is string && data.settingsJson.size() <= 12000)) &&
             (!('createdAt' in data) || data.createdAt == null || (data.createdAt is timestamp && data.createdAt <= request.time)) &&
             (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidDailyProgress(data) {
      return isSaneDocSize(data, 12) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.streakCurrent is int && data.streakCurrent >= 0 && data.streakCurrent <= 100000 &&
             data.streakBest is int && data.streakBest >= 0 && data.streakBest <= 100000 &&
             data.freezesAvailable is int && data.freezesAvailable >= 0 && data.freezesAvailable <= 2 &&
             (!('lastCompletedDay' in data) || data.lastCompletedDay == null || (data.lastCompletedDay is string && data.lastCompletedDay.size() <= 16)) &&
             data.skillsJson is string && data.skillsJson.size() <= 12000 &&
             data.dailyStateJson is string && data.dailyStateJson.size() <= 80000 &&
             (!('mistakeBookJson' in data) || data.mistakeBookJson == null || (data.mistakeBookJson is string && data.mistakeBookJson.size() <= 120000)) &&
             (!('createdAt' in data) || data.createdAt == null || (data.createdAt is timestamp && data.createdAt <= request.time)) &&
             (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidDaySyncDoc(data) {
      return isSaneDocSize(data, 10) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.day is string && data.day.size() == 10 && data.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             (!('part' in data) || (data.part is int && data.part >= 1 && data.part <= 20)) &&
             data.totals is map && data.totals.keys().size() <= 10 &&
             data.categories is map && data.categories.keys().size() <= 64 &&
             data.answers is list && data.answers.size() <= 1500 &&
             (!('createdAt' in data) || data.createdAt == null || (data.createdAt is timestamp && data.createdAt <= request.time)) &&
             (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidScoreDoc(data) {
      return isSaneDocSize(data, 12) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.mode is string && data.mode.size() >= 1 && data.mode.size() <= 40 &&
             data.difficulty is string && data.difficulty.size() >= 1 && data.difficulty.size() <= 30 &&
             data.count is int && data.count >= 1 && data.count <= 500 &&
             data.correct is int && data.correct >= 0 && data.correct <= data.count &&
             data.timeMs is int && data.timeMs >= 0 && data.timeMs <= 7200000 &&
             (!('accuracy' in data) || (data.accuracy is number && data.accuracy >= 0.0 && data.accuracy <= 1.0)) &&
             data.ts is int && data.ts >= 0 &&
             (!('createdAt' in data) || data.createdAt == null || (data.createdAt is timestamp && data.createdAt <= request.time)) &&
             (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    match /users/{userId} {
      allow get, list: if isOwner(userId) && isValidId(userId);

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       (!('createdAt' in incoming()) || isGuestActive(incoming().createdAt)) &&
                       incoming().keys().hasAll(['userId', 'displayName', 'avatarId', 'dailyGoal', 'language', 'theme']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'avatarId', 'photoURL', 'email', 'provider', 'dailyGoal', 'language', 'theme', 'accentTheme', 'settingsJson', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming());

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       (!('createdAt' in existing()) || isGuestActive(existing().createdAt)) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['userId', 'displayName', 'avatarId', 'photoURL', 'email', 'provider', 'dailyGoal', 'language', 'theme', 'accentTheme', 'settingsJson', 'createdAt', 'updatedAt']);

      allow delete: if false;

      match /progress/{docId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(docId);
        allow list: if isOwner(userId) && isValidId(userId);

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(docId) &&
                         (!('createdAt' in incoming()) || isGuestActive(incoming().createdAt)) &&
                         incoming().keys().hasAll(['userId', 'streakCurrent', 'streakBest', 'freezesAvailable', 'skillsJson', 'dailyStateJson']) &&
                         incoming().keys().hasOnly(['userId', 'streakCurrent', 'streakBest', 'freezesAvailable', 'lastCompletedDay', 'skillsJson', 'dailyStateJson', 'mistakeBookJson', 'createdAt', 'updatedAt']) &&
                         isValidDailyProgress(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(docId) &&
                         (!('createdAt' in existing()) || isGuestActive(existing().createdAt)) &&
                         isValidDailyProgress(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['userId', 'streakCurrent', 'streakBest', 'freezesAvailable', 'lastCompletedDay', 'skillsJson', 'dailyStateJson', 'mistakeBookJson', 'createdAt', 'updatedAt']);

        allow delete: if false;
      }

      match /days/{dayId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(dayId);
        allow list: if isOwner(userId) && isValidId(userId);

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(dayId) &&
                         (!('createdAt' in incoming()) || isGuestActive(incoming().createdAt)) &&
                         incoming().keys().hasAll(['userId', 'day', 'totals', 'categories', 'answers']) &&
                         incoming().keys().hasOnly(['userId', 'day', 'part', 'totals', 'categories', 'answers', 'createdAt', 'updatedAt']) &&
                         isValidDaySyncDoc(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(dayId) &&
                         (!('createdAt' in existing()) || isGuestActive(existing().createdAt)) &&
                         isValidDaySyncDoc(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().day == existing().day &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['userId', 'day', 'part', 'totals', 'categories', 'answers', 'createdAt', 'updatedAt']);

        allow delete: if false;
      }

      match /scores/{scoreId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(scoreId);
        allow list: if isOwner(userId) && isValidId(userId);

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(scoreId) &&
                         (!('createdAt' in incoming()) || isGuestActive(incoming().createdAt)) &&
                         incoming().keys().hasAll(['userId', 'mode', 'difficulty', 'count', 'correct', 'timeMs', 'ts']) &&
                         incoming().keys().hasOnly(['userId', 'mode', 'difficulty', 'count', 'correct', 'timeMs', 'accuracy', 'ts', 'createdAt', 'updatedAt']) &&
                         isValidScoreDoc(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(scoreId) &&
                         (!('createdAt' in existing()) || isGuestActive(existing().createdAt)) &&
                         isValidScoreDoc(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['userId', 'mode', 'difficulty', 'count', 'correct', 'timeMs', 'accuracy', 'ts', 'createdAt', 'updatedAt']);

        allow delete: if false;
      }
    }
  }
}
