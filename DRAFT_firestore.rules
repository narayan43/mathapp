rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
             data.avatarId is string && data.avatarId.size() >= 1 && data.avatarId.size() <= 40 &&
             (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 600)) &&
             (!('phoneMasked' in data) || data.phoneMasked == null || (data.phoneMasked is string && data.phoneMasked.size() <= 40)) &&
             (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 160)) &&
             data.dailyGoal is int && data.dailyGoal >= 5 && data.dailyGoal <= 200 &&
             data.language is string && data.language.size() >= 2 && data.language.size() <= 12 &&
             data.theme is string && data.theme.size() >= 2 && data.theme.size() <= 32 &&
             (!('settingsJson' in data) || (data.settingsJson is string && data.settingsJson.size() <= 8000)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidDailyProgress(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.streakCurrent is int && data.streakCurrent >= 0 && data.streakCurrent <= 100000 &&
             data.streakBest is int && data.streakBest >= 0 && data.streakBest <= 100000 &&
             data.freezesAvailable is int && data.freezesAvailable >= 0 && data.freezesAvailable <= 2 &&
             (!('lastCompletedDay' in data) || data.lastCompletedDay == null || (data.lastCompletedDay is string && data.lastCompletedDay.size() <= 16)) &&
             data.skillsJson is string && data.skillsJson.size() <= 10000 &&
             data.dailyStateJson is string && data.dailyStateJson.size() <= 60000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidScoreDoc(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.mode is string && data.mode.size() >= 1 && data.mode.size() <= 40 &&
             data.difficulty is string && data.difficulty.size() >= 1 && data.difficulty.size() <= 30 &&
             data.count is int && data.count >= 1 && data.count <= 500 &&
             data.correct is int && data.correct >= 0 && data.correct <= data.count &&
             data.timeMs is int && data.timeMs >= 0 && data.timeMs <= 7200000 &&
             (!('accuracy' in data) || (data.accuracy is number && data.accuracy >= 0.0 && data.accuracy <= 1.0)) &&
             data.ts is int && data.ts >= 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow get, list: if isOwner(userId) && isValidId(userId);

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll(['userId', 'displayName', 'avatarId', 'dailyGoal', 'language', 'theme', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'avatarId', 'photoURL', 'phoneMasked', 'email', 'dailyGoal', 'language', 'theme', 'settingsJson', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming());

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'avatarId', 'photoURL', 'phoneMasked', 'email', 'dailyGoal', 'language', 'theme', 'settingsJson', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(userId);

      match /progress/{docId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(docId);
        allow list: if isOwner(userId) && isValidId(userId);

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(docId) &&
                         incoming().keys().hasAll(['userId', 'streakCurrent', 'streakBest', 'freezesAvailable', 'skillsJson', 'dailyStateJson', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'streakCurrent', 'streakBest', 'freezesAvailable', 'lastCompletedDay', 'skillsJson', 'dailyStateJson', 'createdAt', 'updatedAt']) &&
                         isValidDailyProgress(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(docId) &&
                         isValidDailyProgress(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['streakCurrent', 'streakBest', 'freezesAvailable', 'lastCompletedDay', 'skillsJson', 'dailyStateJson', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(docId);
      }

      match /scores/{scoreId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(scoreId);
        allow list: if isOwner(userId) && isValidId(userId);

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(scoreId) &&
                         incoming().keys().hasAll(['userId', 'mode', 'difficulty', 'count', 'correct', 'timeMs', 'ts', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'mode', 'difficulty', 'count', 'correct', 'timeMs', 'accuracy', 'ts', 'createdAt', 'updatedAt']) &&
                         isValidScoreDoc(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(scoreId) &&
                         isValidScoreDoc(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['mode', 'difficulty', 'count', 'correct', 'timeMs', 'accuracy', 'ts', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(scoreId);
      }

      // Reserved collections for upcoming analytics feature (strictly locked to owner)
      match /answers/{answerId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow write: if false;
      }

      match /aggregates/{aggId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow write: if false;
      }
    }
  }
}
